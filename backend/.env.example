# Copy to .env and fill in
MONGO_URI=mongodb://localhost:27017
MONGO_DB=projectbidding
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
FRONTEND_URL=http://localhost:5173
# Production: set this to your deployed frontend origin(s), comma-separated —
# otherwise browsers block API calls (CORS) and the UI shows fetch errors.
# Example: FRONTEND_URL=https://projectbidding-frontend.onrender.com
# Stripe (optional for MVP — mock mode when blank)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_WEBHOOK_SECRET=
PLATFORM_FEE_PERCENT=10
# S3 (optional for MVP — local disk when USE_S3=false)
USE_S3=false
S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
